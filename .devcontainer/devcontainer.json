{
  "name": "cella",
  "image": "mcr.microsoft.com/devcontainers/rust:2.1.3-trixie",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {
      "extensions": "github/gh-stack",
      "installDirectlyFromGitHubRelease": true,
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/node:2.1.1": {
      "nvmVersion": "latest",
      "pnpmVersion": "none",
      "version": "lts"
    }
  },
  "postCreateCommand": "cargo install cargo-insta"
}
